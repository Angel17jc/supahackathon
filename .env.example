# Server-only. Supabase calls this a secret key (sb_secret_...); it bypasses
# row level security, so it must never appear in a VITE_* variable, in client
# code, or in the repository.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Browser-safe. Supabase calls this a publishable key (sb_publishable_...) and
# it is inlined into the client bundle by design. Row level security is what
# keeps it harmless. The build refuses to start if a secret key is placed here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
